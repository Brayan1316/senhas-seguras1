        let caracteres = "";

        if (uppercase) {
            caracteres += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        }

        if (lowercase) {
            caracteres += "abcdefghijklmnopqrstuvwxyz";
        }

        if (numbers) {
            caracteres += "0123456789";
        }

        if (symbols) {
            caracteres += "!@#$%^&*()_+-=[]{}|;:,.<>?";
        }


        if (caracteres.length === 0) {

            alert(
                "Selecione pelo menos um tipo de caractere."
            );

            return;
        }


        /*
         * crypto.getRandomValues() é utilizado
         * em vez de Math.random().
         *
         * Isso fornece aleatoriedade mais
         * apropriada para geração de senhas.
         */

        const valores =
            new Uint32Array(tamanho);

        crypto.getRandomValues(valores);


        let senha = "";

        for (let i = 0; i < tamanho; i++) {

            const indice =
                valores[i] % caracteres.length;

            senha += caracteres[indice];
        }


        document.getElementById("password").value = senha;

        analisarSenha(
            senha,
            caracteres.length
        );
    }


