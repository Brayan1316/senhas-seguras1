        } else {

            fill.style.background = "#06b6d4";
            text.textContent = "Muito forte";
            text.style.color = "#06b6d4";
        }


        /*
         * ======================================
         * EXIBIÇÃO MATEMÁTICA
         * ======================================
         */

        let combinacoesTexto;


        if (logCombinacoes < 6) {

            const combinacoes =
                Math.pow(
                    tamanhoAlfabeto,
                    tamanho
                );

            combinacoesTexto =
                combinacoes.toLocaleString("pt-BR");

        } else {

            combinacoesTexto =
                "aproximadamente 10^" +
                logCombinacoes.toFixed(1);
        }


        document.getElementById("combinations").innerHTML =

            `Esta senha possui <strong>${tamanho}</strong>
            caracteres e utiliza um conjunto de
            aproximadamente <strong>${tamanhoAlfabeto}</strong>
            caracteres possíveis.<br><br>

            Portanto:<br>

            <code>
                N = ${tamanhoAlfabeto}<sup>${tamanho}</sup>
            </code>

            <br><br>

            Número aproximado de combinações:
            <strong>${combinacoesTexto}</strong>`;


        /*
         * ======================================
         * VERIFICAÇÕES DE SEGURANÇA
         * ======================================
         */

        let problemas = [];


        if (tamanho < 12) {
            problemas.push(
                "A senha possui menos de 12 caracteres."
            );
        }

        if (!/[A-Z]/.test(senha)) {
            problemas.push(
                "Não possui letras maiúsculas."
            );
        }

        if (!/[a-z]/.test(senha)) {
            problemas.push(
                "Não possui letras minúsculas."
            );
        }

        if (!/[0-9]/.test(senha)) {
            problemas.push(
                "Não possui números."
            );
        }

        if (!/[^A-Za-z0-9]/.test(senha)) {
            problemas.push(
                "Não possui símbolos."
            );
        }


        const status =
            document.getElementById("securityStatus");


        if (problemas.length === 0) {

            status.style.background =
                "rgba(34, 197, 94, 0.15)";

            status.style.color = "#86efac";

            status.innerHTML =
                "✅ Esta senha atende aos principais critérios de segurança.";

        } else {

            status.style.background =
                "rgba(245, 158, 11, 0.15)";

            status.style.color = "#fcd34d";

            status.innerHTML =
                "⚠️ Pontos que podem ser melhorados:<br><br>" +
                problemas.map(
                    problema => "• " + problema
                ).join("<br>");
        }
    }


    /*
     * ==========================================
     * COPIAR SENHA
     * ==========================================
     */

    async function copiarSenha() {

        const senha =
            document.getElementById("password").value;


        if (!senha) {

            alert("Gere uma senha primeiro.");

            return;
        }


        try {

            await navigator.clipboard.writeText(senha);

            alert("Senha copiada para a área de transferência!");

        } catch (erro) {

            alert(
                "Não foi possível copiar automaticamente."
            );
        }
    }


    /*
     * ==========================================
     * ATUALIZAR TAMANHO
     * ==========================================
     */

    function atualizarTamanho() {

        const tamanho =
            document.getElementById("length").value;

        document.getElementById("lengthValue")
            .textContent = tamanho;
    }


    /*
     * Gera uma senha automaticamente
     * quando a página é aberta.
     */

    gerarSenha();

</script>

</body>
</html>
